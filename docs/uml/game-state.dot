/* Final domain model of scala-man. Render: dot -Tsvg docs/uml/game-state.dot -o docs/uml/game-state.svg */
digraph DomainModel {
  graph [rankdir=TB, fontname="Helvetica", labelloc=t, label="scala-man — domain model", fontsize=18]
  node [shape=plain, fontname="Helvetica", fontsize=10]
  edge [fontname="Helvetica", fontsize=9]

  LevelState [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="5">
      <tr><td bgcolor="#e8eef7"><b>&#171;case class&#187;<br/>LevelState</b></td></tr>
      <tr><td align="left">maze: ValidatedMap<br/>player: MovingEntity<br/>enemies: Vector[Enemy]<br/>collectibles: Collectibles<br/>effects: ActiveEffects<br/>progress: LevelProgress<br/>mode: GameMode<br/>score: ScoreTracker<br/>clock: GameClock</td></tr>
      <tr><td align="left">status(): GameState<br/>liveScore: Int<br/>pipeline(...): GameStateUpdatePipeline</td></tr>
    </table>
  >]
  ValidatedMap [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="5">
      <tr><td bgcolor="#e8eef7"><b>&#171;case class&#187;<br/>ValidatedMap</b></td></tr>
      <tr><td align="left">raw: RawMap<br/>spawn: Position<br/>enemies: Set[EnemySpawn]<br/>teleports: Map[Int, (Position, Position)]</td></tr>
      <tr><td align="left">isWalkable(position): Boolean</td></tr>
    </table>
  >]
  RawMap [label="&#171;case class&#187;\nRawMap\nrows: Vector[Vector[Tile]]"]
  MovingEntity [label="&#171;case class&#187;\nMovingEntity\ncurrentPos: Position\nfacing: Direction\nmovement: Option[Movement]"]
  Enemy [label="&#171;case class&#187;\nEnemy\nentity: MovingEntity\nkind: EnemyKind\nheading: Option[Position]"]
  Collectibles [label="&#171;trait&#187;\nCollectibles\nplaced: Set[Collectible]\nremaining: Int"]
  Collectible [label="&#171;enum&#187;\nCollectible\nBasic(position)\nBonus(position, effect)"]
  ActiveEffects [label="&#171;trait&#187;\nActiveEffects\nactive(now): Set[BonusEffect]"]
  GameMode [label="&#171;trait&#187;\nGameMode\nstatus(...): GameState\nscoringRule: ScoringRule"]
  LevelProgress [label="&#171;case class&#187;\nLevelProgress\nlives: Int"]
  ScoreTracker [label="&#171;case class&#187;\nScoreTracker\ncurrentScore: Int\ncombo: Int"]
  GameClock [label="&#171;case class&#187;\nGameClock\nelapsed: FiniteDuration"]
  Movement [label="&#171;case class&#187;\nMovement\nfrom, to: Position"]
  EnemySpawn [label="&#171;case class&#187;\nEnemySpawn\nposition: Position\nkind: EnemyKind"]
  Tile [label="&#171;enum&#187;\nTile\nWall | Floor | Spawn | Collectible\nHunter | Anticipator | Patroller\nInvulnerabilityBonus | SlowdownBonus\nTeleport(code)"]
  Position [label="&#171;case class&#187;\nPosition\nrow, col: Int"]
  Direction [label="&#171;enum&#187;\nDirection\nUp | Down | Left | Right"]
  EnemyKind [label="&#171;enum&#187;\nEnemyKind\nHunter | Anticipator | Patroller"]
  BonusEffect [label="&#171;enum&#187;\nBonusEffect\nInvulnerability | SlowDown"]
  GameState [label="&#171;enum&#187;\nGameState\nRunning | Paused | Victory | Defeat"]
  Normal [label="Normal"]
  Timed [label="Timed(limit)"]
  Survival [label="Survival(difficultyEvery, maximumSpeedMultiplier)"]

  LevelState -> { ValidatedMap MovingEntity Enemy Collectibles ActiveEffects LevelProgress ScoreTracker GameClock } [dir=back, arrowtail=diamond, arrowhead=none]
  LevelState -> GameMode [arrowhead=vee]
  LevelState -> GameState [arrowhead=vee]
  ValidatedMap -> { RawMap EnemySpawn } [dir=back, arrowtail=diamond, arrowhead=none]
  ValidatedMap -> Position [arrowhead=vee]
  RawMap -> Tile [dir=back, arrowtail=diamond, arrowhead=none]
  Enemy -> MovingEntity [dir=back, arrowtail=diamond, arrowhead=none]
  Enemy -> EnemyKind [arrowhead=vee]
  EnemySpawn -> { Position EnemyKind } [arrowhead=vee]
  MovingEntity -> { Position Direction Movement } [arrowhead=vee]
  Collectibles -> Collectible [dir=back, arrowtail=diamond, arrowhead=none]
  Collectible -> { Position BonusEffect } [arrowhead=vee]
  ActiveEffects -> BonusEffect [arrowhead=vee]
  GameMode -> { Normal Timed Survival } [dir=back, arrowtail=empty, arrowhead=none]
}
