flowchart LR
  subgraph V[View — ScalaFX boundary]
    Menu[MenuScreen]
    Board[GameBoard / Frame]
  end
  subgraph C[Controller — application orchestration]
    App[Application]
    Session[GameSession]
    Port[GameEnvironment]
  end
  subgraph P[Presentation — framework-independent read model]
    Snapshot[LevelView projection]
    Render[Rendering / RenderListener]
  end
  subgraph M[Model — pure domain]
    State[LevelState aggregate]
    Rules[GameMode policies]
    Map[ValidatedMap value object]
  end
  subgraph I[Infrastructure — adapters]
    Files[GameFilesEnvironment]
    Storage[Maps, saves, leaderboards]
  end

  Menu -->|commands| App
  Board -->|commands| App
  App -->|creates / controls| Session
  App -->|depends on port| Port
  Session -->|applies pipeline| State
  State -->|delegates outcome / score| Rules
  State -->|queries walkability| Map
  State -->|is projected as| Snapshot
  Render -->|notifies| Snapshot
  Snapshot -->|rendered by| Board
  Files -. implements .-> Port
  Files -->|uses| Storage
