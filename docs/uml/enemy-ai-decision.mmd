flowchart LR
  stage["EnemyAiStage"]
  idle{"Enemy idle?"}
  unchanged["Keep current movement"]
  selector["EnemyStrategySelector"]
  context["EnemyMovementContext"]
  strategy["EnemyMovementStrategy"]
  navigation["EnemyMovement\nordered moves and BFS"]
  movement["Assign next movement"]
  noMove["Keep current position"]

  stage --> idle
  idle -->|"no"| unchanged
  idle -->|"yes"| selector
  selector --> strategy
  context -. immutable input .-> strategy
  strategy --> navigation
  navigation -->|"Some(next position)"| movement
  navigation -->|"None"| noMove
