%%{init: {"theme": "neutral"}}%%
classDiagram
direction LR

class LevelState {
  <<aggregate root>>
  +maze: ValidatedMap
  +player: MovingEntity
  +enemies: Vector~Enemy~
  +collectibles: Collectibles
  +effects: ActiveEffects
  +progress: LevelProgress
  +mode: GameMode
  +score: ScoreTracker
  +clock: GameClock
  +status()
  +liveScore: Int
  +pipeline()
}
class ValidatedMap {
  <<value object>>
  +raw: RawMap
  +spawn: Position
  +teleports: Map~Int, PositionPair~
  +isWalkable(position: Position) Boolean
}
class MovingEntity {
  <<value object>>
  +currentPos: Position
  +facing: Direction
  +movement: Option~Movement~
}
class Enemy {
  <<entity>>
  +entity: MovingEntity
  +kind: EnemyKind
  +heading: Option~Position~
}
class LevelProgress {
  +lives
}
class ScoreTracker {
  +currentScore
  +combo
}
class GameClock {
  +elapsed
}

class GameMode {
  <<interface>>
  +status(progress, collectibles, clock) GameState
  +enemyDelta(delta, clock) FiniteDuration
}
class Collectibles {
  <<interface>>
  +remaining: Int
  +collect(position) Collected
}
class ActiveEffects {
  <<interface>>
  +active(now) Set~BonusEffect~
  +updated(now) ActiveEffects
}

LevelState "1" *-- "1" ValidatedMap : maze
LevelState "1" *-- "1" MovingEntity : player
LevelState "1" *-- "0..*" Enemy : enemies
LevelState "1" *-- "1" Collectibles
LevelState "1" *-- "1" ActiveEffects
LevelState "1" *-- "1" LevelProgress
LevelState "1" *-- "1" ScoreTracker
LevelState "1" *-- "1" GameClock
LevelState "1" --> "1" GameMode

Enemy *-- MovingEntity
GameMode <|.. Normal
GameMode <|.. Timed
GameMode <|.. Survival
