/*
 * scala-man tick pipeline.
 * Render with: dot -Tsvg docs/uml/tick-pipeline.dot -o docs/uml/tick-pipeline.svg
 */
digraph TickPipeline {
  graph [rankdir=TB, fontname="Helvetica", labelloc=t,
         label="scala-man — one game tick", fontsize=18, nodesep=0.4, ranksep=0.55]
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, margin="0.15,0.1"]
  edge [fontname="Helvetica", fontsize=9]

  Frame [label="ScalaFX frame\nMain.framed(now)", fillcolor="#f9e8ef"]
  Application [label="Application.advancedToFrame(now)\nrecords terminal result once", fillcolor="#e9f5e8"]
  Session [label="GameSession.advancedToFrame(now)\ncomputes a non-negative delta\nand caps it at 50 ms", fillcolor="#e9f5e8"]
  Countdown [label="Countdown / pause guard\nno level update while paused\nor before the lead-in ends", fillcolor="#fff7d6"]
  Pipeline [label="LevelState.pipeline(delta)", fillcolor="#e8eef7"]
  Ai [label="1. AI\nidle enemies choose their next step", fillcolor="#e8eef7"]
  Movement [label="2. Clock and movement\nadvance player and enemies", fillcolor="#e8eef7"]
  Collision [label="3. Meetings and teleports\nlose life / defeat enemy / carry entity", fillcolor="#e8eef7"]
  Collection [label="4. Collection\nremove item, grant effect, award event points", fillcolor="#e8eef7"]
  Effects [label="5. Effects\nexpire bonuses and reset combo if needed", fillcolor="#e8eef7"]
  NextStep [label="6. Player intent\nstart pending or current-direction step", fillcolor="#e8eef7"]
  Status [label="Derived status\nRunning · Victory · Defeat", fillcolor="#e8eef7"]
  Rendering [label="Presentation.Rendering\nprojects LevelView and notifies only if changed", fillcolor="#fbf0df"]
  View [label="GameBoard / Frame\ndraw immutable snapshot", fillcolor="#f9e8ef"]

  Frame -> Application -> Session -> Countdown
  Countdown -> Pipeline [label="running and lead-in complete"]
  Countdown -> Rendering [label="otherwise retain state", style=dashed]
  Pipeline -> Ai -> Movement -> Collision -> Collection -> Effects -> NextStep -> Status -> Rendering -> View
}
