@startuml
title scala-man — MVC architecture
left to right direction
skinparam componentStyle rectangle
skinparam linetype ortho

package "View" {
  [MenuScreen]
  [GameBoard]
  [Frame]
}
package "Controller" {
  [Application]
  [GameSession]
  interface GameEnvironment
}
package "Presentation" {
  [LevelView]
  [Rendering]
}
package "Model" {
  [LevelState]
  [GameMode]
  [ValidatedMap]
}
package "Infrastructure" {
  [GameFilesEnvironment]
  [Map loading and validation]
  [Save and leaderboard storage]
}

[Main] --> [Application] : wires
[Main] --> [MenuScreen]
[MenuScreen] --> [Application] : commands
[GameBoard] --> [Application] : commands
[Application] --> [GameSession]
[GameSession] --> [LevelState] : updates
[Application] --> GameEnvironment : uses
[GameFilesEnvironment] ..|> GameEnvironment
[GameFilesEnvironment] --> [Map loading and validation]
[GameFilesEnvironment] --> [Save and leaderboard storage]
[LevelState] --> [GameMode]
[LevelState] --> [ValidatedMap]
[LevelState] --> [LevelView] : projection
[Rendering] --> [LevelView] : publishes
[GameBoard] --> [LevelView] : draws

note bottom of [LevelView]
  Framework-independent read model,
  shared by Controller and View.
end note
@enduml
